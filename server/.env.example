# Copy to server/.env and fill in real values. NEVER commit server/.env.
JWT_SECRET=change-me-to-a-long-random-string
PORT=4010
CLIENT_ORIGIN=http://localhost:5173

# Public base URL used in student emails (tracking + chat links).
PUBLIC_BASE_URL=http://localhost:4010

# The Super ICT Support account is seeded from these on first run (node seed.js).
# Keep them out of the repository.
SUPER_NAME=Super ICT Support
SUPER_EMAIL=
SUPER_PASSWORD=
SUPER_STAFF_NO=ICT/RGP/001

# Cloudinary — stores student receipts/screenshots so they survive redeploys.
# Without these, files are stored on the local disk (fine for local dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP for real email delivery. Until set, emails are queued in the
# outbound_emails table (nothing is lost) and marked pending_credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RUGIPO ICT Support <ict@rugipo.edu.ng>
