# Copy to server/.env and fill in real values. NEVER commit server/.env.
JWT_SECRET=change-me-to-a-long-random-string
PORT=4010
CLIENT_ORIGIN=http://localhost:5173

# Public base URL used in student emails (tracking + chat links).
# In production set this to your live address, e.g. https://ecampus.rugipo.edu.ng
PUBLIC_BASE_URL=http://localhost:4010

# The Super ICT Support account is seeded from these on first run (node seed.js).
# Keep them out of the repository.
SUPER_NAME=Super ICT Support
SUPER_EMAIL=
SUPER_PASSWORD=
SUPER_STAFF_NO=ICT/RGP/001

# Cloudinary — stores student receipts/screenshots so they survive redeploys.
# Without these, files are stored on the local disk (fine for local dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email sending — Brevo (brevo.com). The SENDER must be an address on your
# verified domain, e.g. ict@ecampus.rugipo.edu.ng. See DEPLOY.md "Email that
# arrives, not spam" for the one-time domain verification steps.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RUGIPO ICT Support
